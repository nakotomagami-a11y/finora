{
  "extends": "@finora/tooling/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "incremental": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "types": ["node"]
  },
  "include": ["next-env.d.ts", "src", "e2e", "scripts", "*.ts", "*.mjs", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
