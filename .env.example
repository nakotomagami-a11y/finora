# Copy to .env.local. Every value is optional unless a source or feature you use needs it.
# Never commit .env.local (it is gitignored).

# Where Finora keeps its databases, raw downloads and backups.
FINORA_DATA_DIR=./.data
# The local provider map for Crash monitor's coded sources (C15, C17); never committed, never backed up.
# FINORA_PROVIDERS_FILE=./.data/providers.json
FINORA_PORT=3000
